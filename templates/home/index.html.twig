{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1>Accueil</h1>
    <p>Connecté : {{ app.user.userIdentifier }}</p>
    <p><a href="{{ path('app_integration') }}">Intégration</a></p>
    {# is_granted tient compte de la hiérarchie : l'admin voit aussi ce bouton #}
    {% if is_granted('ROLE_QUALITE') %}
        <p><a href="{{ path('app_user_new') }}">Inscrire un nouvel utilisateur</a></p>
    {% endif %}

    <p><a href="{{ path('app_logout') }}">Se déconnecter</a></p>
{% endblock %}