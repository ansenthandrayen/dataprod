{% extends 'produit/_layout.html.twig' %}

{% block contenu %}
    <h2>Versions et lots</h2>

    {% for version in produit.versions %}
        <h3>Version {{ version.lettre }}</h3>
        {% if version.lots is empty %}
            <p>Aucun lot.</p>
        {% else %}
            <ul>
                {% for lot in version.lots %}
                    <li>
                        <a href="{{ path('app_integration_scan', {id: produit.id, lotId: lot.id}) }}">{{ lot.numero }}</a>
                        — {{ lot.systemes|length }} intégré(s) sur {{ lot.quantitePrevue }} prévu(s)
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% else %}
        <p>Aucune version définie pour ce produit.</p>
    {% endfor %}
{% endblock %}