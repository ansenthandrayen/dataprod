{% extends 'produit/_layout.html.twig' %}

{% block title %}Intégration — {{ produit.reference }}{% endblock %}

{% block contenu %}
    <h2>Intégration</h2>
    <p>Scannez ou saisissez le numéro de lot de <strong>{{ produit.reference }}</strong>.</p>

    {{ form_start(form) }}
        {{ form_row(form.numero) }}
        <button type="submit">Continuer</button>
    {{ form_end(form) }}
{% endblock %}