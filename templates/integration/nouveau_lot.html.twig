{% extends 'produit/_layout.html.twig' %}

{% block title %}Nouveau lot — {{ produit.reference }}{% endblock %}

{% block contenu %}
    <h2>Nouveau lot</h2>

    <p>
        Le lot <strong>{{ numero }}</strong> n'existe pas encore. Il sera créé pour
        <strong>{{ version.referenceProduit.reference }}</strong>, version <strong>{{ version.lettre }}</strong>.
    </p>

    {{ form_start(form) }}
        {{ form_row(form.quantitePrevue) }}
        <button type="submit">Créer le lot</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_integration', {id: produit.id}) }}">Changer de lot</a></p>
{% endblock %}