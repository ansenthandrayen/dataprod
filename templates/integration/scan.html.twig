{% extends 'produit/_layout.html.twig' %}

{% block title %}Lot {{ lot.numero }}{% endblock %}

{% block contenu %}
    {# Style provisoire, à déplacer dans un fichier CSS quand on fera le vrai style #}
    <style>
        input[data-etat="ok"] { border: 2px solid green; }
        input[aria-invalid="true"] { border: 2px solid red; }
        .erreur-scan { color: red; }
    </style>

    <h2>Lot {{ lot.numero }}</h2>

    {# Compteur calculé, jamais stocké : on compte les systèmes du lot #}
    <p>{{ lot.systemes|length }} intégré(s) sur {{ lot.quantitePrevue }} prévu(s)</p>

    <h3>Composition attendue</h3>
    <ul>
        {% for ligne in lot.versionProduit.nomenclatures %}
            <li>
                {{ ligne.referenceSousEnsemble.reference }} × {{ ligne.quantite }}
                (versions acceptées :
                {% for v in ligne.versionsAcceptees %}{{ v.lettre }}{% if not loop.last %}, {% endif %}{% endfor %})
            </li>
        {% endfor %}
    </ul>

    {% if erreurs %}
        <div role="alert">
            <p>Intégration refusée :</p>
            <ul>
                {% for erreur in erreurs %}
                    <li>{{ erreur }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {{ form_start(form, {attr: {
        'data-controller': 'scan',
        'data-scan-url-value': path('app_integration_controle', {id: produit.id, lotId: lot.id}),
        'data-action': 'keydown->scan#touche change->scan#changement input->scan#saisie',
    }}) }}
        {{ form_widget(form) }}
        <button type="submit">Valider l'intégration</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_integration', {id: produit.id}) }}">Changer de lot</a></p>
{% endblock %}